{
  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/Documents/Ferrite/.tools/node/bin:${env:HOME}/.cargo/bin:${env:HOME}/bin:${env:PATH}"
  },
  "rust-analyzer.linkedProjects": [
    "Cargo.toml"
